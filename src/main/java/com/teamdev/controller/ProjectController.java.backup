package com.teamdev.controller;

import com.teamdev.entity.Project;
import com.teamdev.entity.ProjectVersion;
import com.teamdev.service.ProjectService;
import com.teamdev.service.ProjectVersionService;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.*;

import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * 项目管理控制器
 * 提供项目相关的CRUD操作接口，包括项目基本信息管理和版本管理
 */
@RestController
@RequestMapping("/api/projects")
public class ProjectController {
    
    @Autowired
    private ProjectService projectService;
    
    @Autowired
    private ProjectVersionService projectVersionService;
    
    /**
     * 获取项目信息（支持按名称过滤）
     * @param projectName 项目名称（可选）
     * @return 包含项目列表的响应对象
     */
    @GetMapping
    public Map<String, Object> getAllProjects(@RequestParam(required = false) String projectName) {
        Map<String, Object> result = new HashMap<>();
        try {
            List<Project> projects = projectService.getAllProjects(projectName);
            result.put("code", 200);
            result.put("data", projects);
            result.put("message", "查询成功");
        } catch (Exception e) {
            e.printStackTrace();
            result.put("code", 500);
            result.put("success", false);
            result.put("message", "查询失败: " + e.getMessage());
            result.put("error", e.getClass().getSimpleName() + ": " + e.getMessage());
        }
        return result;
    }
    
    /**
     * 根据ID获取项目信息
     * @param id 项目ID
     * @return 包含项目信息的响应对象
     */
    @GetMapping("/{id}")
    public Map<String, Object> getProjectById(@PathVariable Long id) {
        Project project = projectService.getProjectById(id);
        Map<String, Object> result = new HashMap<>();
        result.put("code", 200);
        result.put("data", project);
        result.put("message", "查询成功");
        return result;
    }
    
    /**
     * 创建项目
     * @param project 项目对象
     * @return 操作结果响应对象
     */
    @PostMapping
    public Map<String, Object> createProject(@RequestBody Project project) {
        boolean success = projectService.saveProject(project);
        Map<String, Object> result = new HashMap<>();
        result.put("code", success ? 200 : 500);
        result.put("success", success);
        result.put("message", success ? "创建成功" : "创建失败");
        return result;
    }
    
    /**
     * 更新项目信息
     * @param id 项目ID
     * @param project 项目对象
     * @return 操作结果响应对象
     */
    @PutMapping("/{id}")
    public Map<String, Object> updateProject(@PathVariable Long id, @RequestBody Project project) {
        project.setId(id);
        boolean success = projectService.updateProject(project);
        Map<String, Object> result = new HashMap<>();
        result.put("code", success ? 200 : 500);
        result.put("success", success);
        result.put("message", success ? "更新成功" : "更新失败");
        return result;
    }
    
    /**
     * 删除项目
     * @param id 项目ID
     * @return 操作结果响应对象
     */
    @DeleteMapping("/{id}")
    public Map<String, Object> deleteProject(@PathVariable Long id) {
        boolean success = projectService.deleteProject(id);
        Map<String, Object> result = new HashMap<>();
        result.put("code", success ? 200 : 500);
        result.put("success", success);
        result.put("message", success ? "删除成功" : "删除失败");
        return result;
    }
    
    /**
     * 根据项目名称搜索项目
     * @param projectName 项目名称
     * @return 包含项目列表的响应对象
     */
    @GetMapping("/search")
    public Map<String, Object> searchProjects(@RequestParam(required = false) String projectName) {
        List<Project> projects = projectService.getAllProjects(projectName);
        Map<String, Object> result = new HashMap<>();
        result.put("code", 200);
        result.put("data", projects);
        result.put("message", "查询成功");
        return result;
    }

    /**
     * 获取当前用户参与的所有未开始和进行中的项目
     * @param userId 用户ID
     * @return 包含项目列表的响应对象
     */
    @GetMapping("/my")
    public Map<String, Object> getMyProjects(@RequestParam Long userId) {
        Map<String, Object> result = new HashMap<>();
        try {
            List<Project> projects = projectService.getUserActiveProjects(userId);
            result.put("code", 200);
            result.put("data", projects);
            result.put("message", "查询成功");
        } catch (Exception e) {
            e.printStackTrace();
            result.put("code", 500);
            result.put("success", false);
            result.put("message", "查询失败: " + e.getMessage());
        }
        return result;
    }

    /**
     * 获取所有未开始和进行中的项目（活跃项目）
     * @return 包含项目列表的响应对象
     */
    @GetMapping("/active")
    public Map<String, Object> getActiveProjects() {
        Map<String, Object> result = new HashMap<>();
        try {
            List<Project> projects = projectService.getAllActiveProjects();
            result.put("code", 200);
            result.put("data", projects);
            result.put("message", "查询成功");
        } catch (Exception e) {
            e.printStackTrace();
            result.put("code", 500);
            result.put("success", false);
            result.put("message", "查询失败: " + e.getMessage());
        }
        return result;
    }

    // 获取项目的版本列表
    /**
     * 根据项目ID获取项目版本列表
     * @param projectId 项目ID
     * @return 包含项目版本列表的响应对象
     */
    @GetMapping("/{projectId}/versions")
    public Map<String, Object> getProjectVersions(@PathVariable Long projectId) {
        List<ProjectVersion> versions = projectVersionService.getProjectVersionsByProjectId(projectId);
        Map<String, Object> result = new HashMap<>();
        result.put("code", 200);
        result.put("data", versions);
        result.put("message", "查询成功");
        return result;
    }
}